AI_API_KEY=your_api_key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_CHAT_TEMPERATURE=0.3
AI_EDIT_TEMPERATURE=0
# 全局模型请求限流：所有任务合计每分钟最多发起 9 次真实 Provider 调用。
AI_MODEL_MAX_CALLS_PER_MINUTE=9
# 上下文预算默认值；阶段 2 接入模型目录后可由模型元数据覆盖。
# AI_CONTEXT_WINDOW_TOKENS=128000
# AI_MAX_OUTPUT_TOKENS=8192
# AI_CONTEXT_SAFETY_MARGIN_TOKENS=2048
# Agent 总预算分为正常、收敛和强制结论三个区间；三个值必须满足 24 > 3 > 1。
# AI_AGENT_MAX_STEPS=24
# AI_AGENT_CONVERGENCE_REMAINING_STEPS=3
# AI_AGENT_FORCE_FINAL_REMAINING_STEPS=1
# 完全相同的工具调用：第二次警告并允许读取缓存，第三次起由 Runtime 阻断。
# AI_AGENT_REPEAT_WARNING_THRESHOLD=2
# AI_AGENT_REPEAT_BLOCK_THRESHOLD=3
# 连续工具调用没有带来新文件、证据、补丁、修改、命令结果或工作流推进时，先恢复策略，再次达到阈值后停止。
# AI_AGENT_MAX_NO_PROGRESS_STEPS=4
# AI_AGENT_RECOVERY_ATTEMPTS=1
# 单个 Agent 执行超时、瞬时错误重试及只读 DAG 并发上限
# AI_AGENT_TIMEOUT_MS=60000
# AI_AGENT_MAX_ATTEMPTS=3
# AI_AGENT_RETRY_BASE_DELAY_MS=400
# AI_AGENT_RETRY_MAX_DELAY_MS=2000
# AI_AGENT_MAX_CONCURRENCY=3
# AI_AGENT_MAX_ORCHESTRATION_STEPS=30
# AI_AGENT_MAX_REPLANS=3
# 单轮任务的模型预算：Token 为主阈值，调用次数只用于防止异常循环；耗尽后任务会暂停，继续任务即获得新一轮预算。
# AI_AGENT_MAX_MODEL_CALLS=80
# AI_AGENT_MAX_INPUT_TOKENS=500000
# AI_AGENT_MAX_OUTPUT_TOKENS=80000
# 启用阶段 3 的分级恢复决策；默认关闭以保持旧 Runtime 行为。
# AGENT_PROGRESSIVE_RECOVERY_ENABLED=0
# 阶段六灰度：shadow（仅记录）-> internal -> 10 -> 50 -> all；关闭任一 Flag 即刻回退旧 Runtime 路径。
# AGENT_PROGRESSIVE_DELIVERY_ROLLOUT=shadow
# Optional: persist full AI request/response payloads to .mini-ai/state/runtime/ai-logs.
# AI_FULL_IO_LOGGING=1

# 阶段 5 起四项能力默认启用；需要紧急回退时可将对应值显式设置为 0。
CONTEXT_BUDGET_V2_ENABLED=1
MODEL_PROVIDER_GATEWAY_ENABLED=1
LSP_ENABLED=1
# 启用后按工作区依赖、Web IDE 内置依赖、PATH 的顺序发现 Language Server，不会自动下载。
# LSP_DEBUG_LOGGING=1
INLINE_EDIT_ENABLED=1
# 命令执行 V2 默认开启；设为 0 时保留旧 /api/commands/run 兼容契约作为紧急回退。
COMMAND_EXECUTION_V2_ENABLED=1
# Agent 新文件自治灰度开关；关闭时可分别回退到旧引用门禁和旧完成判定。
AGENT_PLANNED_FILE_RESOLUTION=1
AGENT_SEMANTIC_COMPLETION_CHECK=1
AGENT_EXPLICIT_COMPLETION_TOOL=1
# 显式完成协议灰度：shadow -> 10 -> 50 -> all -> strict；紧急回滚可关闭上方总开关。
AGENT_EXPLICIT_COMPLETION_ROLLOUT=shadow
SAFE_EDIT_EVIDENCE_V2_ENABLED=1
# 阶段六任务完成策略：三个能力可独立回滚，灰度按稳定任务桶执行 off -> 10 -> 50 -> all。
AGENT_TASK_RUNTIME_EVIDENCE_PERSISTENCE=1
AGENT_COMPLETION_REJECTION_CONVERGENCE=1
AGENT_STRUCTURED_COMPLETION_REJECTION=1
AGENT_TASK_COMPLETION_ROLLOUT=all
# COMMAND_EXECUTION_RETENTION_LIMIT=100
# COMMAND_EXECUTION_RETENTION_DAYS=30
# COMMAND_EXECUTION_MAX_LOG_FILE_BYTES=5242880
# COMMAND_EXECUTION_MAX_WORKSPACE_LOG_BYTES=52428800

# Project Memory 阶段 6 灰度开关；总开关关闭后立即停止候选写入和 Prompt 注入。
PROJECT_MEMORY_V3_ENABLED=1
PROJECT_MEMORY_AUTO_EXTRACTION_ENABLED=1
PROJECT_MEMORY_RETRIEVAL_ENABLED=1
PROJECT_MEMORY_VALIDATION_ENABLED=1
# 关闭后不写召回解释日志，也不采集进程内聚合指标。
PROJECT_MEMORY_USAGE_LOG_ENABLED=1

# Optional: enable External Context Gateway web and official-document searches.
# BRAVE_SEARCH_API_KEY=your_brave_search_api_key
# BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search
# EXTERNAL_CONTEXT_TIMEOUT_MS=15000
# EXTERNAL_CONTEXT_MAX_RESPONSE_BYTES=1000000
# Comma-separated domains that may be marked as verified official sources.
# EXTERNAL_CONTEXT_TRUSTED_DOC_DOMAINS=nodejs.org,react.dev
# Enable only when a trusted local proxy maps public hosts into 198.18.0.0/15.
# EXTERNAL_CONTEXT_ALLOW_PROXY_MAPPED_ADDRESSES=0
# Optional browser automation overrides. By default the server discovers local Chrome or Edge.
# EXTERNAL_BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# EXTERNAL_BROWSER_CHANNEL=chrome
# EXTERNAL_BROWSER_PROXY_URL=http://127.0.0.1:7890

SERVER_PORT=3001
# Optional: override local app state storage. Defaults to .mini-ai/state/web-editor.
# STATE_DIRECTORY=.mini-ai/state/web-editor
# LangGraph 迁移尚未完成，默认保持 Legacy；仅在受控验证环境显式设为 true。
AGENT_LANGGRAPH_RUNTIME_ENABLED=false
# 已批准写任务的细分灰度：off/shadow/internal/10/50/all；shadow 不会重复真实写入。
# 总开关关闭时本配置不生效；未配置时保持总开关原有的 all 语义。
AGENT_LANGGRAPH_WRITE_MODE=off
# 只读 Agent 灰度模式：off（默认）、shadow（只对照）、internal（仅显式内部任务）、10、50、all。
# 10/50 使用 TaskSession ID 稳定分桶；一旦请求选中 LangGraph，新路径不可用或执行失败会直接报错，不回退 Legacy。
AGENT_LANGGRAPH_READ_ONLY_MODE=off
