AI_API_KEY=your_api_key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_CHAT_TEMPERATURE=0.3
AI_EDIT_TEMPERATURE=0
# Optional: persist full AI request/response payloads to .mini-ai/state/runtime/ai-logs.
# AI_FULL_IO_LOGGING=1

# Optional: enable External Context Gateway web and official-document searches.
# BRAVE_SEARCH_API_KEY=your_brave_search_api_key
# BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search
# EXTERNAL_CONTEXT_TIMEOUT_MS=15000
# EXTERNAL_CONTEXT_MAX_RESPONSE_BYTES=1000000
# Comma-separated domains that may be marked as verified official sources.
# EXTERNAL_CONTEXT_TRUSTED_DOC_DOMAINS=nodejs.org,react.dev
# Enable only when a trusted local proxy maps public hosts into 198.18.0.0/15.
# EXTERNAL_CONTEXT_ALLOW_PROXY_MAPPED_ADDRESSES=0
# Optional browser automation overrides. By default the server discovers local Chrome or Edge.
# EXTERNAL_BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# EXTERNAL_BROWSER_CHANNEL=chrome
# EXTERNAL_BROWSER_PROXY_URL=http://127.0.0.1:7890

SERVER_PORT=3001
# Optional: override local app state storage. Defaults to .mini-ai/state/web-editor.
# STATE_DIRECTORY=.mini-ai/state/web-editor
